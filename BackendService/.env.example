# Copy to .env. Keep credentials out of source control. Use the dedicated opc_app role.
OPC_DATABASE_URL=postgresql://opc_app:CHANGE_ME@127.0.0.1:5432/opc_dev
OPC_HALL_AUDIENCE=internal
# disabled until the business acquisition mechanism is confirmed.
# record_confirmed only records an independently confirmed relationship; it does not implement bidding/claiming.
OPC_ASSIGNMENT_MODE=disabled
OPC_STORAGE_ROOT=.local/files
OPC_DOCS_ENABLED=true
OPC_CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
